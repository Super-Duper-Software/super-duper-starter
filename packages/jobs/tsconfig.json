{
  "extends": "@superdupersoftware/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
